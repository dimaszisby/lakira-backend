# =============================================================================
# Lakira Backend — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Identity (set by bootstrap-fork.sh when forking)
# -----------------------------------------------------------------------------
APP_NAME=lakira-backend

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
REQUEST_BODY_LIMIT=1mb
# Number of proxy hops to trust (set to 1 for Render/Railway/Heroku). Default: 1
# TRUST_PROXY=1

# -----------------------------------------------------------------------------
# Security / Auth
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins. Default: http://localhost:3000
# -----------------------------------------------------------------------------
CORS_ORIGIN=https://app.example.com,https://admin.example.com

# -----------------------------------------------------------------------------
# Database
# Use DATABASE_URL (takes precedence) or the individual DB_* vars.
# Per-environment URLs are resolved automatically based on NODE_ENV.
# -----------------------------------------------------------------------------
DATABASE_URL=
# These take precedence over the DB_* vars below (see normalizeDatabaseConfig in
# zodEnv.ts), so their credentials must match DB_USER/DB_PASSWORD — and the database
# names must match what docker compose actually creates.
DEVELOPMENT_DATABASE_URL=postgresql://lakira_user:lakira_password@127.0.0.1:5432/lakira_development
TEST_DATABASE_URL=postgresql://lakira_user:lakira_password@127.0.0.1:5432/lakira_test_db
STAGING_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lakira_staging
PRODUCTION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lakira_production

# Individual DB connection vars (used when DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=5432
# These three are what docker compose uses to CREATE the database (POSTGRES_USER /
# POSTGRES_PASSWORD / POSTGRES_DB), so they must match what .env.test connects as —
# the test database lives in the same container. Change them and you must recreate
# the volume: docker compose down -v && docker compose up -d
DB_USER=lakira_user
DB_PASSWORD=lakira_password
DB_NAME=lakira_development
DB_LOGGING=false
# error | warn | info | http | verbose | debug | silly.
# Production defaults to `http` so access logs are included; `silly` is refused in production.
LOG_LEVEL=debug
DB_SSL_REJECT_UNAUTHORIZED=false

# -----------------------------------------------------------------------------
# Redis
# Use REDIS_URL (takes precedence) or the individual REDIS_* vars.
# -----------------------------------------------------------------------------
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRED=true
ENABLE_REDIS_INTEGRATION=false

# -----------------------------------------------------------------------------
# RabbitMQ
# Use RABBITMQ_URL (takes precedence) or the individual RABBITMQ_* vars.
# -----------------------------------------------------------------------------
RABBITMQ_ENABLED=false
RABBITMQ_URL=
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=5
RABBITMQ_RETRY_BASE_DELAY_MS=2000

# -----------------------------------------------------------------------------
# Rate Limiting
# Set DISABLE_RATE_LIMITING=true only for local testing / fuzzing.
# -----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_USER_MAX=50
RATE_LIMIT_ANALYTICS_MAX=30
RATE_LIMIT_SWITCH_ORG_MAX=10
RATE_LIMIT_PASSWORD_RESET_EMAIL_MAX=3
RATE_LIMIT_PASSWORD_RESET_IP_MAX=10
RATE_LIMIT_EMAIL_VERIFICATION_EMAIL_MAX=3
RATE_LIMIT_EMAIL_VERIFICATION_IP_MAX=10
DISABLE_RATE_LIMITING=false

# -----------------------------------------------------------------------------
# Email / Password Reset
# EMAIL_PROVIDER: "console" (logs to stdout) | "resend" (sends via Resend API)
# Staging and production default to "resend" and require RESEND_API_KEY.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
FRONTEND_RESET_URL=http://localhost:3000/reset-password
FRONTEND_VERIFY_URL=http://localhost:3000/verify-email
FRONTEND_INVITE_URL=http://localhost:3000/invites/accept
INVITE_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_SEC=86400

# -----------------------------------------------------------------------------
# API Docs (Swagger / OpenAPI)
# Set SWAGGER_REQUIRE_AUTH=false to allow unauthenticated access to /api/v1/docs
# -----------------------------------------------------------------------------
SWAGGER_REQUIRE_AUTH=true

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_DUMMY_ENDPOINTS=true
ALLOW_TEST_HTTP_SERVER=false
# Skips the database bootstrap at startup. Test-only; refused when NODE_ENV=production.
SKIP_DB_LIFECYCLE=false

# -----------------------------------------------------------------------------
# Observability
# Set SENTRY_DSN to enable Sentry error reporting (staging/production).
# Leaving it unset is a true no-op — no global handlers, no network calls.
# SENTRY_TRACES_SAMPLE_RATE: fraction of transactions sampled (0 = off).
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# -----------------------------------------------------------------------------
# Release identity (ADR-0039 Part 1)
# APP_RELEASE: commit SHA identifying this build. CI/the platform sets this; Render
# also auto-exposes RENDER_GIT_COMMIT as a fallback. Leave unset locally — it
# defaults to "unknown".
# -----------------------------------------------------------------------------
APP_RELEASE=

# -----------------------------------------------------------------------------
# Analytics / Visualization
# Tuning knobs for the analytics visualization queries, caching, and TZ default.
# All values shown below are the defaults — uncomment to override.
# -----------------------------------------------------------------------------
# Max bucket count per visualization request (range guard)
# VIZ_MAX_BUCKETS=400
# Max metrics returned per dashboard visualization request
# VIZ_DASH_MAX_METRICS=24
# Redis TTL (seconds) for cached visualization payloads
# VIZ_DEFAULT_TTL_SEC=120
# Cache-Control: max-age (seconds) for dashboard responses
# VIZ_CACHE_MAX_AGE_SEC=60
# Cache-Control: stale-while-revalidate (seconds) for dashboard responses
# VIZ_CACHE_STALE_SEC=30
# Guard window (buckets) used when computing fallback range for empty series
# VIZ_FALLBACK_GUARD_BUCKETS=96
# Default IANA time zone applied when a request omits `tz`
# DEFAULT_TZ=Asia/Jakarta

# -----------------------------------------------------------------------------
# Testing (optional — only relevant when running Jest locally)
# -----------------------------------------------------------------------------
JEST_TIMEOUT=30000
