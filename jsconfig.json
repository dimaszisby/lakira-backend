{
  "compilerOptions": {
    "target": "ES2020", // Specify ECMAScript target version
    "module": "commonjs", // Specify module code generation
    "baseUrl": ".", // Base directory to resolve non-relative module names
    "paths": {
      // Define path aliases for cleaner imports
      "@tests/*": ["tests/*"]
    },
    "checkJs": false, // Enable type checking on JavaScript files
    "allowSyntheticDefaultImports": true, // Allow default imports from modules with no default export
    "esModuleInterop": true, // Enables emit interoperability between CommonJS and ES Modules
    "moduleResolution": "node", // Use Node.js module resolution strategy
    "resolveJsonModule": true, // Allow importing JSON modules
    "noEmit": true, // Do not emit compiled JavaScript files
    "strict": true, // Enable all strict type-checking options
    "skipLibCheck": true, // Skip type checking of all declaration files
    "types": ["jest"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "__tests__/**/*.ts",
    "jest.setup.ts",
    "jest.setup.unit.ts"
  ],
  "exclude": ["node_modules", "dist", "src/migrations", "seeders"]
}
