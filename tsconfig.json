{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "rootDir": ".",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@utils/*": ["src/utils/*"],
      "@config/*": ["src/config/*"],
      "@/features/auth": ["src/features/shared/auth/index"],
      "@/features/auth/*": ["src/features/shared/auth/*"],
      "@/features/metric": ["src/features/public/metric/index"],
      "@/features/metric/*": ["src/features/public/metric/*"],
      "@/features/metric-category": [
        "src/features/public/metric-category/index"
      ],
      "@/features/metric-category/*": ["src/features/public/metric-category/*"],
      "@/features/metric-settings": [
        "src/features/public/metric-settings/index"
      ],
      "@/features/metric-settings/*": ["src/features/public/metric-settings/*"],
      "@/features/metric-log": ["src/features/public/metric-log/index"],
      "@/features/metric-log/*": ["src/features/public/metric-log/*"],
      "@/features/analytics": ["src/features/public/analytics/index"],
      "@/features/analytics/*": ["src/features/public/analytics/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": ["node", "jest"],
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "declaration": false,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "NodeNext"
    }
  },
  "include": [
    "*.ts",
    "src/**/*",
    "tests/**/*",
    "__tests__/**/*.ts",
    "jest.setup.ts",
    "jest.setup.unit.ts",
    "jest.config.mjs",
    "scripts/**/*.cjs",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    // Contract-test runners are plain Node ESM scripts, not part of the typed
    // build. They were never type-checked while they lived under `docs/`;
    // `include: tests/**/*` (a no-op before they moved here) would otherwise
    // pull them into the strict checkJs project.
    "tests/contract/**/*.js"
  ]
}
